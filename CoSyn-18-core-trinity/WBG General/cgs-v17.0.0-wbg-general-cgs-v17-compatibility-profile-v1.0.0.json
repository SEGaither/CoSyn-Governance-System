  "compatibility_contract": {
    "description": "Permit resolution of registered WBG source artifacts whose embedded legacy parent-governance metadata references CoSyn CGS v16.3.3 or v16.3.5, when all five required conditions pass. This resolution does not modify source artifact semantics except for interpretation of the registered legacy parent-governance reference.",
    "activation_status": "RATIFIED / ACTIVE — ratified as part of CoSyn v17.0.0 repository operationalization",
    "required_conditions": [
      {
        "id": "condition_1",
        "description": "Active CGS is exactly 17.0.0"
      },
      {
        "id": "condition_2",
        "description": "Ratified active WBG Root is 1.2.0 or a valid explicit successor that preserves this compatibility contract"
      },
      {
        "id": "condition_3",
        "description": "Artifact identity matches a registered entry in this compatibility profile"
      },
      {
        "id": "condition_4",
        "description": "Artifact SHA-256 matches the registered entry hash — source bytes are byte-for-byte identical to the registered version"
      },
      {
        "id": "condition_5",
        "description": "The conflict is specifically and only a registered legacy parent-governance reference; no other authority, dependency, integrity, capability, or semantic conflict exists"
      }
    ],
    "proposed_interpretation": {
      "registered_legacy_parents": ["16.3.3", "16.3.5"],
      "effective_parent_under_compatibility": "CoSyn CGS 17.0.0",
      "scope": "Parent-governance reference resolution only. All other source artifact semantics, content, and provenance remain unchanged.",
      "source_byte_preservation": "Compatibility succeeds only when source bytes match the registered SHA-256 exactly. No source content is modified."
    },
    "failure_mode": "WBG V17 COMPATIBILITY: FAIL_CLOSED",
    "must_not": [
      "perform generic version replacement outside registered entries",
      "ignore arbitrary stale metadata not covered by registered entries",
      "authorize unregistered artifacts",
      "dynamically repair or rewrite source content",
      "permit mixed CGS versions across the active governance stack",
      "weaken subordinate governance constraints",
      "reinterpret provenance records or external ratification evidence"
    ]
  },
